# Mode
# Set NODE_ENV in the shell or npm script (e.g. `pnpm dev`); it picks which .env.<NODE_ENV>*
# files are loaded, so a value here only fills in when the shell leaves it unset.
NODE_ENV=

# Database
# The same database as the API.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASS=
DB_NAME=
DB_DIALECT=

# Log Retention
# Set to true to delete old audit trail, login history and error log rows. When it is not true
# this app has nothing to do and exits.
LOG_RETENTION_ENABLED=
# How often the cleanup runs (default 24). It also runs once on startup.
LOG_RETENTION_INTERVAL_HOURS=
# Keep rows for this many days. Empty or 0 keeps them forever.
AUDIT_TRAIL_RETENTION_DAYS=
AUDIT_LOGIN_RETENTION_DAYS=
ERROR_LOG_RETENTION_DAYS=

# Cleanup
# Rows deleted per statement (default 5000).
CLEANUP_BATCH_SIZE=
